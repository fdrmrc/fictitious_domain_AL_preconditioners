subsection Distributed Lagrange<1,2>
  set Coupling quadrature order                    = 3
  set Dirichlet boundary ids                       = 0, 1, 2, 3
  set Embedded space finite element degree         = 1
  set Embedding space finite element degree        = 1
  set Initial embedded space refinement            = 3#7
  set Initial embedding space refinement           = 4#8
  set Local refinements steps near embedded domain = 1#0
  set Number of refinement cycles                  = 7#8
  set Solver                                       = augmented
  set Verbosity level                              = 10

  subsection AL preconditioner
    set Augmentation constant = 10.0
    set Use diagonal inverse = true
    set Use operator version = true
    set Use geometric multigrid = true
    # If true (and GMG is false), invert the augmented block with one V-cycle
    # of plain algebraic multigrid (Trilinos ML). GMG takes precedence.
    set Use algebraic multigrid = true
    # Vertex-patch smoother used by the GMG V-cycle:
    #   "petsc_asm"  -> PETSc PCASM (restricted additive Schwarz, LU per patch)
    #   "classical"  -> in-house symmetric additive Schwarz vertex patch
    #   "jacobi"     -> simple (damped) point-Jacobi smoother
    set GMG smoother variant = petsc_asm #jacobi  
    # true  -> fatten patches touching the interface with surrounding Gamma cells
    # false -> plain vertex-star patches everywhere (no fattening)
    set GMG fatten patches around interface = false
    # true  -> one patch per level cell (cell's own DoFs only; 4 DoFs for Q1 in 2D)
    # false -> overlapping vertex-star patches
    set GMG single cell patches = true
    set GMG smoother relaxation             = 0.8
    set GMG smoother steps                  = 1
  end

  subsection Grid generation
    # Background (embedding) grid: deal.II built-in or "from_file".
    set Background grid generator                     = hyper_cube
    set Background grid generator arguments           = 0.0: 1.0: true
    # "hex" (quads/hexes) or "simplex" (tris/tets).
    set Background mesh type                          = hex

    # Embedded (immersed) grid: deal.II built-in or "from_file".
    # "hyper_sphere" arguments: <center> : <radius>.
    set Embedded grid generator                       = hyper_sphere
    set Embedded grid generator arguments             = 0.4, 0.4 : 0.2
    set Embedded mesh type                            = hex

    # Used only when the corresponding "* grid generator" above is set
    # to "from_file".
    set External background grid file                 =
    set External embedded grid file                   =
    set Scale factor for the external background grid = 1
    set Scale factor for the external embedded grid   = 1
  end

  subsection Embedded value
    set Function constants  =
    set Function expression = 1
    set Variable names      = x,y,t
  end

  subsection Embedding Dirichlet boundary conditions
    set Function constants  =
    set Function expression = 0
    set Variable names      = x,y,t
  end

  subsection Embedding rhs function
    set Function constants  =
    set Function expression = 1
    set Variable names      = x,y,t
  end

  subsection Schur solver control
    set Log frequency = 1
    set Log history   = true
    set Log result    = true
    set Max steps     = 1000
    set Reduction     = 1e-9
    set Tolerance     = 1e-12
  end
end


