# TEST CASE: rectangular steel bar immersed in a soft block, compressed.
#
#   Background (Omega_tilde) : 40 x 40 x 80 mm rectangular block of a stiff
#                              elastomer (a slender mount)
#   Immersed   (B)           : 18 x 18 x 54 mm structural-steel bar, i.e. an
#                              elongated inclusion of aspect ratio 1 : 1 : 3,
#                              running along the loading direction and centred
#                              at the origin -> symmetric in all three
#                              directions
#
#
# UNITS: length mm, stress MPa (= N/mm^2), force in N. Displacements come out in mm.
#
#   Structural steel   E = 210 000 MPa, nu = 0.30
#     mu     = E / (2 (1 + nu))               =  80769.2308 MPa
#     lambda = E nu / ((1 + nu)(1 - 2 nu))    = 121153.8462 MPa
#   Stiff elastomer    E =      50 MPa, nu = 0.45
#     mu     =                                 =     17.2414 MPa
#     lambda =                                 =    155.1724 MPa
#
#   contrast: mu_B / mu_Omega = 4.7e3,  lambda_B / lambda_Omega = 7.8e2
#
subsection Elasticity Interface Problem
  set lambda background                  = 155.1724
  set lambda immersed                    = 115385.
  set mu background                      = 17.24
  set mu immersed                        = 76923.
  set Coupling quadrature order          = 3
  set FE degree background               = 1
  set FE degree immersed                 = 1
  # Colorized hyper_rectangle boundary ids:
  #   0 = x_min, 1 = x_max, 2 = y_min, 3 = y_max, 4 = z_min, 5 = z_max
  # Bottom (z_min) clamped, top (z_max) pushed down by Compression delta,
  # the four sides left traction free(sigma * n = 0).
  set Homogeneous Dirichlet boundary ids = 4
  set Top compression boundary id        = 5

  set Compression delta                  = 5
  set Output directory                   = ./output_elasticity_op_elongated
  set Use fixed (inner) iterations       = false

  subsection Right hand side f_1
    set Function constants  =
    set Function expression = 0.; 0.; 0.
    set Variable names      = x,y,z,t
  end

  subsection Right hand side f_2 - f
    set Function constants  =
    set Function expression = 0.; 0.; 0.
    set Variable names      = x,y,z,t
  end

  subsection AL preconditioner
    set Use modified AL preconditioner = true
    # gamma_1 = gamma fluid / h_imm^2 and gamma_2 = gamma solid / h_imm^2,
    # so BOTH gammas carry units of stress (MPa)
    set gamma fluid                    = 2e3
    set gamma solid                    = 2e1
    set Verbosity level                = 4
  end

  subsection Grid generation
    # subdivided_hyper_rectangle: <repetitions> : <p1> : <p2> : <colorize>.
    # Repetitions proportional to the edge lengths => cubic coarse cells.
    set Background grid generator           = subdivided_hyper_rectangle
    set Background grid generator arguments = 4, 4, 8 : -20., -20., -40. : 20., 20., 40. : true
    set Immersed grid generator             = subdivided_hyper_rectangle
    set Immersed grid generator arguments   = 2, 2, 6 : -9., -9., -27. : 9., 9., 27. : false
    set Mesh type background                = hex
    set Mesh type immersed                  = hex
    # If non-empty, the corresponding mesh is read from disk (GridIn::read_msh)
    # and the GridGenerator name/arguments above are ignored for that mesh.
    set Name of the external background grid file = #
    set Name of the external immersed grid file   = #
    # Uniform scaling factor applied to the immersed mesh (generated or
    # external) via GridTools::scale before global refinement.
    set Immersed grid scale factor          = 1.0
    set FE triple                           = Q1-Bubble-Q0
  end

  subsection Inner solver control
    set Log frequency = 1
    set Log history   = false
    set Log result    = true
    set Max steps     = 100000
    set Reduction     = 1.e-12
    set Tolerance     = 1.e-2
  end

  subsection Iteration number control
    set Log frequency = 1
    set Log history   = false
    set Log result    = true
    set Max steps     = 30
    set Tolerance     = 1.e-4
  end

  subsection Outer solver control
    set Log frequency = 1
    set Log history   = true
    set Log result    = true
    set Max steps     = 1000
    set Reduction     = 1.e-6
    set Tolerance     = 1.e-20
  end

  subsection Refinement and remeshing
    set Initial background refinement = 2
    set Initial immersed refinement   = 1
    set Refinemented cycles           = 4
    set Interface refinement levels   = 0
  end

end